DATABASE_HOST="localhost"
DATABASE_PORT=3306
DATABASE_NAME="carzen_db"
DATABASE_USER="root"
DATABASE_PASSWORD=123456789

# JWT settings
SECRET_KEY = "supersecretkey"  # in real apps: put in .env
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 1440

# Razorpay (never expose RAZORPAY_KEY_SECRET to the Flutter client)

# Set this to the per-payment limit approved for the Razorpay account.
# The default in code is 5000000 paise (₹50,000).
RAZORPAY_MAX_ORDER_AMOUNT_PAISE=5000000
